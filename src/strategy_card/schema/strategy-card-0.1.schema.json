{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajib2k5/strategy-card/schema/strategy-card-0.1.schema.json",
  "title": "Strategy card 0.1",
  "description": "A one-page disclosure card for a backtest. Analysis only; not investment advice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy", "test_window", "costs", "trials", "performance", "data"],
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/isoDate" },
        "end": { "$ref": "#/$defs/isoDate" }
      }
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sharpe": {
      "type": "number",
      "minimum": -1000,
      "maximum": 1000,
      "description": "Annualized Sharpe ratio. |SR| above 1000 is treated as an input error."
    }
  },
  "properties": {
    "schema_version": { "const": "0.1" },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "test_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_sample", "out_of_sample"],
      "properties": {
        "in_sample": { "$ref": "#/$defs/window" },
        "out_of_sample": { "$ref": "#/$defs/window" }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fees_bps", "slippage_bps", "model"],
      "properties": {
        "fees_bps": { "type": "number", "minimum": 0 },
        "slippage_bps": { "type": "number", "minimum": 0 },
        "model": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "How costs were charged, e.g. 'per side, on traded notional'."
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "log": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Path to, or description of, the log of every variant tried. Never opened by the tool."
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periods_per_year", "sharpe"],
      "properties": {
        "periods_per_year": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 525960,
          "description": "At most one period per minute of a 365.25-day year."
        },
        "sharpe": {
          "type": "object",
          "description": "Annualized Sharpe ratios of per-period excess returns.",
          "additionalProperties": false,
          "required": ["in_sample", "out_of_sample"],
          "properties": {
            "in_sample": { "$ref": "#/$defs/sharpe" },
            "out_of_sample": { "$ref": "#/$defs/sharpe" }
          }
        },
        "deflated_sharpe": {
          "type": "object",
          "description": "Deflated Sharpe Ratio (Bailey & Lopez de Prado 2014).",
          "additionalProperties": false,
          "required": [
            "value",
            "n_trials",
            "sharpe_annualized",
            "sr_benchmark_annualized",
            "trial_sharpe_variance_annualized",
            "n_observations",
            "skew",
            "kurtosis_pearson"
          ],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "n_trials": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "sharpe_annualized": { "$ref": "#/$defs/sharpe" },
            "sr_benchmark_annualized": { "$ref": "#/$defs/sharpe" },
            "trial_sharpe_variance_annualized": { "type": "number", "minimum": 0 },
            "n_observations": { "type": "integer", "minimum": 2, "maximum": 100000000 },
            "skew": { "type": "number" },
            "kurtosis_pearson": { "type": "number", "minimum": 1 },
            "method": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_in_time", "survivorship", "sources"],
      "properties": {
        "point_in_time": { "enum": ["as_reported", "restated", "mixed", "unknown"] },
        "survivorship": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handling"],
          "properties": {
            "handling": {
              "enum": ["includes_delisted", "survivor_only", "not_applicable", "unknown"]
            },
            "notes": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "url": { "$ref": "#/$defs/nonEmptyString" },
              "license": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    }
  }
}
